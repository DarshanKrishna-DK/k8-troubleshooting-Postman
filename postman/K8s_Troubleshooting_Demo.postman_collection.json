              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "999"]
            },
            "description": "Tests 404 handling for non-existent products."
          },
          "response": []
        },
        {
          "name": "Filter Products by Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('All products are Books', function () {",
                  "    const json = pm.response.json();",
                  "    json.products.forEach(product => {",
                  "        pm.expect(product.category).to.eql('Books');",
                  "    });",
                  "});",
                  "",
                  "console.log('📚 Found ' + pm.response.json().count + ' books');"
