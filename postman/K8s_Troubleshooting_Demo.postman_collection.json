            "description": "Always returns a 500 error. Useful for testing error handling."
          },
          "response": []
        },
        {
          "name": "Chaos Test (50% Fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This test expects either success or failure",
                  "pm.test('Response received (success or failure)', function () {",
                  "    pm.expect([200, 500, 502, 503, 504]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    console.log('✅ Chaos test PASSED');",
                  "} else {",
                  "    console.log('❌ Chaos test FAILED with ' + pm.response.code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/chaos?failChance=0.5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chaos"],
              "query": [
                {
                  "key": "failChance",
                  "value": "0.5"
                }
              ]
            },
            "description": "Randomly fails 50% of the time. Run multiple times to see the behavior."
          },
          "response": []
        }
      ]
    },
    {
      "name": "🔄 Load Balancing Test",
      "description": "Tests to verify K8s is distributing traffic across pods",
      "item": [
        {
          "name": "Check Pod Distribution (Run 10x)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Track which pods respond",
                  "const json = pm.response.json();",
                  "const podName = json.pod;",
                  "",
                  "// Get or initialize pod tracking",
                  "let podCounts = pm.collectionVariables.get('podCounts');",
                  "if (!podCounts) {",
                  "    podCounts = {};",
                  "}",
                  "if (typeof podCounts === 'string') {",
                  "    podCounts = JSON.parse(podCounts);",
                  "}",
                  "",
                  "// Increment count for this pod",
                  "podCounts[podName] = (podCounts[podName] || 0) + 1;",
                  "pm.collectionVariables.set('podCounts', JSON.stringify(podCounts));",
                  "",
                  "// Log current distribution",
                  "console.log('📊 Pod Distribution:');",
                  "Object.entries(podCounts).forEach(([pod, count]) => {",
                  "    console.log(`   ${pod}: ${count} requests`);",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Reset tracking on first iteration",
                  "const iteration = pm.info.iteration;",
                  "if (iteration === 0) {",
                  "    pm.collectionVariables.unset('podCounts');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/info",
              "host": ["{{baseUrl}}"],
              "path": ["api", "info"]
            },
            "description": "Run this request 10 times using Collection Runner to see load balancing across pods."
          },
          "response": []
        }
      ]
    },
    {
      "name": "🚨 Failure Scenario Tests",
      "description": "Tests to run when things are broken",
      "item": [
        {
          "name": "Health Check - Expect Failure",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// When using broken config, health checks may fail",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Health check passed', function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.status).to.eql('healthy');",
                  "    });",
                  "    console.log('✅ Health check passed');",
                  "} else if (pm.response.code === 503) {",
                  "    pm.test('Health check failed as expected', function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.status).to.eql('unhealthy');",
                  "    });",
                  "    console.log('❌ Health check failed: ' + pm.response.json().error);",
                  "} else {",
                  "    pm.test('Unexpected response', function () {",
                  "        pm.expect.fail('Got unexpected status: ' + pm.response.code);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Use this when testing with broken configurations to see failure behavior."
          },
          "response": []
        },
        {
          "name": "Readiness Check - Expect Failure",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// When using broken-db config, readiness should fail",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Readiness check passed', function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.ready).to.be.true;",
                  "    });",
                  "    console.log('✅ App is ready, DB: ' + pm.response.json().database);",
                  "} else if (pm.response.code === 503) {",
                  "    pm.test('Readiness check failed as expected', function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.ready).to.be.false;",
                  "    });",
                  "    console.log('❌ App not ready: ' + pm.response.json().error);",
                  "    console.log('   DB Host: ' + pm.response.json().dbHost);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": ["{{baseUrl}}"],
              "path": ["ready"]
            },
            "description": "Use this when testing with broken-db configuration."
          },
          "response": []
        },
        {
          "name": "Connection Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Basic connection test",
                  "pm.test('Service is reachable', function () {",
                  "    pm.expect(pm.response).to.exist;",
                  "});",
                  "",
                  "if (pm.response.code >= 200 && pm.response.code < 500) {",
                  "    console.log('✅ Service is reachable');",
                  "} else {",
                  "    console.log('❌ Service returned error: ' + pm.response.code);",
                  "}",
                  "",
                  "console.log('⏱️ Response time: ' + pm.response.responseTime + 'ms');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/info",
              "host": ["{{baseUrl}}"],
              "path": ["api", "info"]
            },
            "description": "Basic test to check if the service is reachable at all."
          },
          "response": []
        }
      ]
    }
